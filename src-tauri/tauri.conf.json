{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeDeck",
  "version": "0.1.3",
  "identifier": "app.vibedeck.space",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "VibeDeck", "width": 1600, "height": 960, "minWidth": 900, "minHeight": 600,
        "backgroundColor": "#070b14", "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
